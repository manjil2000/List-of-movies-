{% extends 'base.twig' %}{% block content %}<h1>Explore your collection</h1><p>Find movies by combining any of the filters below.</p><form id="search" class="panel filters" method="get" action="search_movie.php"><label>Movie name<input name="name" list="suggestions" maxlength="100" value="{{ filters.name|e }}"><datalist id="suggestions"></datalist></label><label>Genre<select name="genre"><option value="">All genres</option>{% for g in genres %}<option value="{{ g|e }}" {{ filters.genre == g ? 'selected' : '' }}>{{ g|e }}</option>{% endfor %}</select></label><label>Release year<select name="year"><option value="">All years</option>{% for y in years %}<option value="{{ y|e }}" {{ filters.year == y ? 'selected' : '' }}>{{ y|e }}</option>{% endfor %}</select></label><label>Maximum price (£)<input name="price" type="number" min="0" step="0.01" value="{{ filters.price|e }}"></label><button>Search</button><a href="list-movies.php" id="reset">Reset</a></form><p id="status" role="status">{{ error ? error : movies|length ~ ' movies found' }}</p><div id="results" class="collection">{% for m in movies %}<article class="panel"><h2>{{ m.Movie_name|e }}</h2><p>{{ m.Genre|e }} · {{ m.Date_of_release|e }}</p><strong>£{{ m.Price|number_format(2) }}</strong><p><a href="edit_movie.php?id={{ m.Movie_id|e }}">Edit</a> · <a href="delete_movie.php?id={{ m.Movie_id|e }}">Delete</a></p></article>{% endfor %}</div>{% endblock %}{% block scripts %}<script src="assets/search.js" defer></script>{% endblock %}
