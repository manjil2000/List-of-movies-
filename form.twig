{% extends 'base.twig' %}{% block content %}<section class="panel narrow"><h1>{{ editing ? 'Edit movie' : 'Add movie' }}</h1>{% if error %}<p class="error">{{ error|e }}</p>{% endif %}<form method="post"><input type="hidden" name="csrf" value="{{ csrf|e }}"><label>Movie name<input name="Movie_name" maxlength="100" required value="{{ movie.Movie_name|default('')|e }}"></label><label>Genre<input name="Genre" maxlength="20" required value="{{ movie.Genre|default('')|e }}"></label><label>Price (£)<input type="number" name="Price" min="0" step="0.01" required value="{{ movie.Price|default('')|e }}"></label><label>Release date<input type="date" name="Date_of_release" required value="{{ movie.Date_of_release|default('')|e }}"></label><button>Save movie</button> <a href="list-movies.php">Cancel</a></form></section>{% endblock %}
