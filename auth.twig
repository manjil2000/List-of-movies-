{% extends 'base.twig' %}{% block content %}<section class="panel narrow"><h1>{{ register ? 'Create account' : 'Sign in' }}</h1>{% if error %}<p class="error">{{ error|e }}</p>{% endif %}<form method="post"><input type="hidden" name="csrf" value="{{ csrf|e }}"><label>Username<input name="username" required maxlength="50" autocomplete="username"></label><label>Password<input type="password" name="password" required autocomplete="{{ register ? 'new-password' : 'current-password' }}"></label><label>CAPTCHA: {{ question|e }} = ?<input name="captcha" required inputmode="numeric"></label><button>{{ register ? 'Register' : 'Login' }}</button></form><p><a href="{{ register ? 'login.php' : 'register.php' }}">{{ register ? 'Already registered? Sign in' : 'Create an account' }}</a></p></section>{% endblock %}
